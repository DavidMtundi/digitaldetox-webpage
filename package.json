{
  "name": "digitaldetox-webpage",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node node_modules/next/dist/bin/next build && node scripts/strip-rsc-txt.mjs",
    "export": "next build && next export",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "echo 'Firestore rules for digitaldetox-app must be deployed from the DigitalDetox repo.' && exit 1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.4.0",
    "lucide-react": "^0.546.0",
    "next": "15.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
