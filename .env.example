# Pauseward web — copy to .env.local and adjust for your environment.
# Restart `npm run dev` after changing this file.

# pauseward-api base URL (no trailing slash)
NEXT_PUBLIC_PAUSEWARD_API_URL=http://localhost:8080

# Store / download links (optional; Android Play Store has a code default)
NEXT_PUBLIC_DOWNLOAD_GOOGLE_PLAY=https://play.google.com/store/apps/details?id=com.davidmtundi.digitaldetox&pcampaignid=web_share
